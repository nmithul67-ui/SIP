# =============================================================================
# FinOS Production & Sandbox Configuration Guide (.env.example)
# Location: fintech_pos/.env
# =============================================================================

# Active Payment Gateway: 'paypal' or 'decentro' (Default: paypal)
PAYMENT_GATEWAY=paypal

# -----------------------------------------------------------------------------
# 1. PAYPAL / MOCKGATEWAY REST API CREDENTIALS (Orders v2 & Tabletop Checkout)
# Developer Portal: https://developer.paypal.com/dashboard/applications
# Where to obtain:
#   1. Sign in to PayPal Developer Dashboard (https://developer.paypal.com) or use MockGateway.
#   2. Under "Apps & Credentials", click "Create App".
#   3. Select App Type: "Merchant".
#   4. Copy your Client ID and Secret Key into PAYPAL_CLIENT_ID & PAYPAL_CLIENT_SECRET.
#   5. Choose Mode: "sandbox" for test orders, "live" for production transactions.
#   6. Choose Currency: "USD", "EUR", "GBP", "CAD", "AUD", "INR", etc.
#   7. If using custom/mock gateway, set PAYPAL_BASE_URL (e.g. https://mockgateway.com/api/base/paypal-1bse7u).
# -----------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://mockgateway.com/api/base/paypal-1bse7u
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# PayPal Webhook URL to register in your PayPal App Dashboard:
# https://<your-domain>/api/v1/fintech/paypal/webhook
# Events to subscribe:
#   - CHECKOUT.ORDER.APPROVED
#   - PAYMENT.CAPTURE.COMPLETED
#   - PAYMENT.CAPTURE.DENIED

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For Local Development / Prototyping (zero-setup SQLite):
DATABASE_URL=sqlite+aiosqlite:///./finos.db

# For Production (High Concurrency Managed PostgreSQL, e.g. AWS RDS, Supabase, Neon):
# DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword123@your-db-host.rds.amazonaws.com:5432/finos_prod

# -----------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API (Paperless E-Invoicing Engine)
# Portal: https://developers.facebook.com | WhatsApp Cloud API
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=finos_wa_verify_token_2026

# Alternative WhatsApp Provider (Optional fallback: Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# 4. SETU ACCOUNT AGGREGATOR (AA) GATEWAY (Automated Bank Audit & Reconciliation)
# Portal: https://setu.co | Bridge / FIU Gateway
# -----------------------------------------------------------------------------
SETU_AA_BASE_URL=https://fiu-uat.setu.co
SETU_AA_CLIENT_ID=your_setu_fiu_client_id
SETU_AA_CLIENT_SECRET=your_setu_fiu_client_secret
SETU_AA_PRODUCT_ID=your_setu_product_instance_id

# -----------------------------------------------------------------------------
# 5. STORE IDENTITY & TAX COMPLIANCE DEFAULTS
# -----------------------------------------------------------------------------
DEFAULT_MERCHANT_GSTIN=27AAACW1234F1Z5
DEFAULT_STORE_NAME=Royal Indian Biryani & Cafe
DEFAULT_STORE_ADDRESS=Shop 14, Commercial Complex, Sector 18, Pune, MH 411001
DEFAULT_MERCHANT_VPA=royalbiryani@icici

# -----------------------------------------------------------------------------
# 6. EXPO TABLET FRONTEND CLIENT URL
# In local dev: http://localhost:8000
# In multi-device local network: http://<LAN-IP>:8000 (e.g. http://192.168.1.50:8000)
# In cloud production: https://api.yourdomain.com
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 7. DECENTRO UPI & CREDIT LINE (Alternative Gateway)
# Portal: https://decentro.tech | Sandbox: https://in.decentro.tech
# -----------------------------------------------------------------------------
DECENTRO_CLIENT_ID=your_decentro_client_id
DECENTRO_CLIENT_SECRET=your_decentro_client_secret
DECENTRO_MODULE_SECRET=your_decentro_module_secret
DECENTRO_PROVIDER_SECRET=your_decentro_provider_secret
DECENTRO_BASE_URL=https://in.decentro.tech
DECENTRO_WEBHOOK_SECRET=your_decentro_webhook_secret
